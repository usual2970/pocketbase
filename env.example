# Database Configuration Examples
# Copy this file to .env and adjust values as needed

# MySQL Configuration
PB_DB_TYPE=mysql
PB_DB_DSN=root:rootpassword@tcp(localhost:3306)/pocketbase?parseTime=true&charset=utf8mb4&loc=Local

# PostgreSQL Configuration (alternative)
# PB_DB_TYPE=postgres
# PB_DB_DSN=postgres://pocketbase:pocketbase123@localhost:5432/pocketbase?sslmode=disable&search_path=public

# Connection Pool Settings (optional)
PB_DB_MAX_OPEN=50
PB_DB_MAX_IDLE=25
PB_DB_CONN_MAX_LIFETIME=30m

# PocketBase Configuration
PB_DATA_DIR=./pb_data
PB_PUBLIC_DIR=./pb_public
